
pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {

        stage('Checkout Java Application') {
            steps {
                echo 'Fetching Java application from GitHub'

                dir('java-app') {
                    git branch: 'main',
                        url: 'https://github.com/YOUR_USERNAME/java-calculator-app.git'
                }
            }
        }

        stage('Maven Build and Test') {
            steps {
                dir('java-app') {
                    echo 'Starting Maven build and testing'

                    sh 'mvn clean test'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true,
                  testResults: 'java-app/target/surefire-reports/*.xml'
        }

        success {
            echo 'All test cases passed successfully!'
        }

        failure {
            echo 'Build or test execution failed!'
        }
    }
}
